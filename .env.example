# Copy this file to .env and fill in real values. Never commit the real .env.

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Only needed when DJANGO_DEBUG=False and serving behind a domain:
DJANGO_CSRF_TRUSTED_ORIGINS=https://yourdomain.com

# Database (MySQL, matching the project's configured engine)
DB_ENGINE=mysql
DB_NAME=student_management
DB_USER=root
DB_PASSWORD=your-mysql-password
DB_HOST=127.0.0.1
DB_PORT=3306

# Set DB_ENGINE=sqlite3 instead to run locally without MySQL installed.
